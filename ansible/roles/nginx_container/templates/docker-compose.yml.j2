services:
  nginx:
    image: nginx:latest
    container_name: "{{ nginx_container_name }}"
    ports:
      - "{{ nginx_host_port }}:{{ nginx_container_port }}"
    volumes:
      - "{{ nginx_html_path }}:/var/www/html"
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf
    restart: unless-stopped
    depends_on:
      - php83
    networks:
      - "{{ webserver_network }}"

  php83:
    image: php:8.3-fpm
    volumes:
      - "{{ nginx_html_path }}:/var/www/html"
    networks:
      - "{{ webserver_network }}"

networks:
  {{ webserver_network }}:
    external: true