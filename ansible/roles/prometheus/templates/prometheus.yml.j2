global:
  scrape_interval: 15s

scrape_configs:
  - job_name: 'node'
    static_configs:
      - targets:
        - 192.168.10.10:9100   # infra
        - 192.168.10.20:9100   # app
        - 192.168.10.30:9100   # auto
        - 192.168.10.40:9100   # monitor

  - job_name: 'cadvisor'
    static_configs:
      - targets:
        - 192.168.10.20:8080